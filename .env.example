# ==============================================================================
# Radar Legislativo — Variáveis de Ambiente (Modelo)
# Copie este arquivo para `.env` e preencha suas credenciais locais.
# Nunca comite o arquivo `.env` no controle de versão.
# ==============================================================================

# Banco de dados principal (PostgreSQL 18 recomendado)
# Exemplo com PostgreSQL local ou Docker Compose:
DATABASE_URL=postgresql+psycopg://radar_user:TROQUE_ESTA_SENHA@localhost:5432/radar_legislativo

# Banco isolado para testes de integração (nunca use o banco principal)
TEST_DATABASE_URL=postgresql+psycopg://radar_user:TROQUE_ESTA_SENHA@localhost:5432/radar_legislativo_test

# Modo de armazenamento:
# - postgres : exige conexão PostgreSQL válida (erro explícito se indisponível)
# - preview  : usa SQLite isolado em data/radar_preview.sqlite (claramente sinalizado na UI)
# - auto     : usa PostgreSQL se DATABASE_URL estiver configurado e acessível; caso contrário falha ou segue modo definido
RADAR_STORAGE_MODE=postgres
PREVIEW_SQLITE_PATH=data/radar_preview.sqlite

# API de Dados Abertos da Câmara dos Deputados
CAMARA_API_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
CAMARA_HTTP_TIMEOUT_SECONDS=15
CAMARA_MAX_RETRIES=3
CAMARA_RATE_LIMIT_DELAY_SECONDS=0.12

# Freshness threshold (dias até sinalizar recorte possivelmente desatualizado na UI)
STALE_DATA_DAYS=7

# Backend HTTP / CORS
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
